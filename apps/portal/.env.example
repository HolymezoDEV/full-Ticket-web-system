# Public URL used for personal customer ticket links
NUXT_PUBLIC_INTAKE_URL=http://127.0.0.1:3001

# Public URL of this portal, used for links in team notification emails
NUXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000

# Resend email delivery; use a verified sender domain
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=

# Optional: secret for signing login sessions (min. 32 characters).
# If empty, one is generated and stored in .data/session-secret.
NUXT_SESSION_SECRET=

# The values above are only defaults. The mail server (SMTP or Resend) can be
# configured in the portal under Einstellungen; those settings take precedence.
